rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{messageId} {
      // Anyone (including signed-out visitors) can submit a contact message.
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.status == 'new';

      // Only signed-in admins can view the inbox or change a message's status.
      allow read, update: if request.auth != null;

      // Nobody can delete messages from the client — do it from the Firebase Console if needed.
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
